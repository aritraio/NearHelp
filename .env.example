# ==============================================================================
# NearHelp AI — Master Environment Configuration Template (.env.example)
# Copy this file to .env in local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & Runtime Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="NearHelp AI"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nearhelp_db
# Connection URL format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nearhelp_db
# Sync connection URL for migrations (Alembic):
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nearhelp_db

# ------------------------------------------------------------------------------
# 3. Redis Cache & WebSocket Session Store
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Backend Service (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=nearhelp_super_secret_jwt_key_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. AI Microservice (Gemini 2.5 + LangGraph + ChromaDB)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://localhost:8001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ------------------------------------------------------------------------------
# 6. Firebase & Push Notifications (FCM)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=nearhelp-ai
FIREBASE_CREDENTIALS_PATH=./firebase_service_account.json
FCM_SERVER_KEY=your_fcm_server_key_here

# ------------------------------------------------------------------------------
# 7. Geospatial & Maps APIs (Google Maps Platform)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
DEFAULT_LATITUDE=22.5726
DEFAULT_LONGITUDE=88.3639
DEFAULT_SEARCH_RADIUS_METERS=1500
MAX_SEARCH_RADIUS_METERS=5000
