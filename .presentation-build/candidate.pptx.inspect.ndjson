{"kind":"textbox","id":"sh/ud0jmtsn","slide":10,"text":"Current limitations","textPreview":"Current limitations","textChars":19,"textLines":1,"bbox":[69,155,500,48]}
{"kind":"textbox","id":"sh/9cr2dor2","slide":10,"text":"The screenshots do not establish successful real-world dispatch or improved response time.","textPreview":"The screenshots do not establish successful real-world dispatch or improved response time.","textChars":90,"textLines":1,"bbox":[70,221,502,80]}
{"kind":"textbox","id":"sh/8bi1kjah","slide":10,"text":"AI answers need systematic checks against verified medical sources before wider use.","textPreview":"AI answers need systematic checks against verified medical sources before wider use.","textChars":84,"textLines":1,"bbox":[70,321,502,80]}
{"kind":"textbox","id":"sh/md8nm5gn","slide":10,"text":"The current demo does not evaluate responder availability or field performance.","textPreview":"The current demo does not evaluate responder availability or field performance.","textChars":79,"textLines":1,"bbox":[70,421,502,80]}
{"kind":"shape","id":"sh/7eh4fax8","slide":10,"bbox":[636,153,0,413]}
