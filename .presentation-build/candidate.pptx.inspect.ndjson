{"kind":"textbox","id":"sh/qd0ze1oj","slide":9,"text":"WHO emphasizes access to quality, timely emergency care. This motivates support during the early response period.","textPreview":"WHO emphasizes access to quality, timely emergency care. This motivates support during the early response period.","textChars":113,"textLines":1,"bbox":[68,337,351,166]}
{"kind":"textbox","id":"sh/bet0n6p4","slide":9,"text":"02","textPreview":"02","textChars":2,"textLines":1,"bbox":[473,158,100,48]}
